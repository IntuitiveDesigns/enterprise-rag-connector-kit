############################################
# Enterprise RAG Connector Kit
# Environment Configuration
############################################

############################################
# Provider Configuration
############################################

# Base URL for your search/chat provider
# Example: https://your-instance.glean.com
GLEAN_BASE_URL=https://your-instance.glean.com

# Datasource / corpus name
GLEAN_DATASOURCE=sample-datasource

# API Tokens (DO NOT COMMIT REAL VALUES)
GLEAN_INDEXING_TOKEN=replace_with_indexing_token
GLEAN_CLIENT_API_TOKEN=replace_with_client_token

# Optional Chat Agent ID
# Leave blank if not required
GLEAN_CHAT_AGENT_ID=

############################################
# Input / Output Configuration
############################################

# Input data source (JSON adapter)
GLEAN_INPUT_JSON_PATH=data/source_docs.json

# Output directory for reports
GLEAN_OUTPUT_DIR=output

# Optional corpus hint used for filtering
GLEAN_CORPUS_HINT=enterprise-rag-demo

############################################
# Runtime Configuration
############################################

# Batch size for indexing
GLEAN_BATCH_SIZE=10

# HTTP Timeout Configuration
GLEAN_CONNECT_TIMEOUT=5.0
GLEAN_READ_TIMEOUT=30.0

# Retry Configuration
GLEAN_MAX_ATTEMPTS=4
GLEAN_BACKOFF_BASE_SECONDS=0.75
GLEAN_BACKOFF_JITTER_SECONDS=0.35

# Logging Level (DEBUG, INFO, WARNING, ERROR)
GLEAN_LOG_LEVEL=INFO

# Run prefix for report naming
GLEAN_RUN_PREFIX=enterprise-rag

# User Agent
GLEAN_USER_AGENT=enterprise-rag-connector-kit/1.0

############################################
# Source Adapter Configuration
############################################

# Supported Values:
# json  -> Local JSON file
# rest  -> REST API Adapter
GLEAN_SOURCE_TYPE=json

############################################
# REST Adapter Configuration
############################################

GLEAN_REST_BASE_URL=https://api.example.com
GLEAN_REST_ENDPOINT_PATH=/v1/documents
GLEAN_REST_API_TOKEN=replace_me

# Authentication
GLEAN_REST_AUTH_HEADER_NAME=Authorization
GLEAN_REST_AUTH_HEADER_PREFIX=Bearer

############################################
# REST Pagination Configuration
############################################

# Supported Values:
# cursor
# page
GLEAN_REST_PAGINATION_MODE=cursor

GLEAN_REST_RECORDS_FIELD=items
GLEAN_REST_PAGE_SIZE=100

# Page-based Pagination
GLEAN_REST_PAGE_NUMBER_PARAM=page

# Cursor-based Pagination
GLEAN_REST_CURSOR_PARAM=cursor
GLEAN_REST_NEXT_CURSOR_FIELD=next_cursor
GLEAN_REST_HAS_MORE_FIELD=has_more

############################################
# REST Field Mapping
############################################

GLEAN_REST_ID_FIELD=id
GLEAN_REST_TITLE_FIELD=title
GLEAN_REST_BODY_FIELD=content
GLEAN_REST_UPDATED_AT_FIELD=updated_at
GLEAN_REST_VIEW_URL_FIELD=url